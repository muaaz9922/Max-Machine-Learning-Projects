unt: 40 segments generated\nTARGET RESOLUTION STATUS: INGESTED AT 800X600 HIGH-FIDELITY MATRIX DIMENSIONS\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x700 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":2},{"cell_type":"markdown","source":"### **SPATIAL ROL & QUEUE GEOFENCING**","metadata":{}},{"cell_type":"code","source":"print(\"📐 Initializing Spatial Geofencing Matrix...\")\n\nif 'frame_analytics_cache' not in globals() or len(frame_analytics_cache) == 0:\n    print(\"⚠️ No tracking data found. Please run Cell 1 first.\")\nelse:\n    # 1. Define Retail Zones (Polygons mapped to the 800x600 resolution)\n    # Zone A: The Kiosk/Display area (bottom center)\n    ZONE_KIOSK = np.array([[300, 400], [550, 400], [600, 580], [250, 580]], np.int32)\n    # Zone B: The Main Walkway/Browsing area (middle band)\n    ZONE_WALKWAY = np.array([[100, 200], [700, 200], [750, 350], [50, 350]], np.int32)\n\n    # Dictionary to hold our business telemetry\n    zone_telemetry = {\n        \"Display Kiosk\": {\"color\": (0, 165, 255), \"poly\": ZONE_KIOSK, \"dwell_frames\": 0, \"unique_shoppers\": set()},\n        \"Main Walkway\": {\"color\": (255, 0, 255), \"poly\": ZONE_WALKWAY, \"dwell_frames\": 0, \"unique_shoppers\": set()}\n    }\n\n    # 2. Process the temporal cache to calculate spatial intersections\n    print(\"🔄 Correlating shopper coordinates with store layout...\")\n    \n    for frame_data in frame_analytics_cache:\n        shoppers = frame_data['shoppers']\n        \n        for shopper in shoppers:\n            cx, cy = shopper['centroid']\n            shopper_id = shopper['id']\n            \n            # Mathematical intersection test: Is the shopper inside the polygon?\n            for zone_name, zone_data in zone_telemetry.items():\n                # pointPolygonTest returns +1 if inside, 0 if on edge, -1 if outside\n                is_inside = cv2.pointPolygonTest(zone_data['poly'], (cx, cy), False)\n                \n                if is_inside >= 0:\n                    zone_data['dwell_frames'] += 1\n                    zone_data['unique_shoppers'].add(shopper_id)\n\n    # 3. Generate the Retail Geofence Visualization (Using the final tracked frame)\n    latest_frame_data = frame_analytics_cache[-1]\n    base_img = latest_frame_data['annotated_image'].copy()\n    overlay = base_img.copy()\n\n    # Draw the translucent zones\n    for zone_name, zone_data in zone_telemetry.items():\n        cv2.fillPoly(overlay, [zone_data['poly']], zone_data['color'])\n        cv2.polylines(base_img, [zone_data['poly']], True, zone_data['color'], 3)\n    \n    # Blend overlay with base image for a high-tech HUD look\n    cv2.addWeighted(overlay, 0.35, base_img, 0.65, 0, base_img)\n\n    # Overlay Live Zone Metrics onto the image\n    y_offset = 40\n    for zone_name, zone_data in zone_telemetry.items():\n        occupancy = len(zone_data['unique_shoppers'])\n        text = f\"{zone_name} | Unique Visitors: {occupancy} | Total Dwell: {zone_data['dwell_frames']} ticks\"\n        cv2.putText(base_img, text, (20, y_offset), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)\n        y_offset += 30\n\n    # 4. Print Executive Metrics\n    print(\"\\n📊 --- SPATIAL CONVERSION METRICS ---\")\n    for zone_name, zone_data in zone_telemetry.items():\n        print(f\"● {zone_name}: {len(zone_data['unique_shoppers'])} unique visitors captured.\")\n        \n    # Cache the telemetry for the Groq LLM in Phase 5\n    cached_zone_telemetry = zone_telemetry\n\n    # 5. Render Panel\n    plt.figure(figsize=(12, 7))\n    plt.style.use('dark_background')\n    rgb_display = cv2.cvtColor(base_img, cv2.COLOR_BGR2RGB)\n    plt.imshow(rgb_display)\n    plt.title(\"PHASE 2: Spatial Geofencing & Customer Intersection Mapping\", fontsize=14, fontweight='bold', color='#00FFCC', pad=15)\n    plt.axis('off')\n    plt.tight_layout()\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-22T04:22:36.577777Z","iopub.execute_input":"2026-05-22T04:22:36.578244Z","iopub.status.idle":"2026-05-22T04:22:37.010577Z","shell.execute_reply.started":"2026-05-22T04:22:36.578199Z","shell.execute_reply":"2026-05-22T04:22:37.009531Z"}},"outputs":[{"name":"stdout","text":"📐 Initializing Spatial Geofencing Matrix...\n🔄 Correlating shopper coordinates with store layout...\n\n📊 --- SPATIAL CONVERSION METRICS ---\n● Display Kiosk: 9 unique visitors captured.\n● Main Walkway: 17 unique visitors captured.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x700 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":3},{"cell_type":"markdown","source":"### **CUMULATIVE DWELL-TIME HEATMAPPING**","metadata":{}},{"cell_type":"code","source":"print(\"🔥 Initializing Thermal Dwell-Time Engine...\")\n\nif 'frame_analytics_cache' not in globals() or len(frame_analytics_cache) == 0:\n    print(\"⚠️ No tracking data found. Please run Phase 1 first.\")\nelse:\n    # 1. Setup the blank spatial accumulator matrix (800x600 float map)\n    base_frame = frame_analytics_cache[0]['image'].copy()\n    height, width = base_frame.shape[:2]\n    thermal_accumulator = np.zeros((height, width), dtype=np.float32)\n\n    print(f\"🗺️ Compiling spatial coordinates across the tracked time buffer...\")\n\n    # 2. Accumulate foot-traffic weight (Injecting \"Heat\" per footprint)\n    for frame_data in frame_analytics_cache:\n        for shopper in frame_data['shoppers']:\n            cx, cy = shopper['centroid']\n            # Draw a solid core of heat at the center of the customer's mass\n            cv2.circle(thermal_accumulator, (cx, cy), radius=25, color=1.0, thickness=-1)\n\n    # Apply a heavy mathematical blur to smooth the footsteps into a continuous thermal cloud\n    thermal_accumulator = cv2.GaussianBlur(thermal_accumulator, (75, 75), 0)\n\n    # 3. Normalize the raw matrix into a standard 8-bit heatmap scale (0 to 255)\n    if np.max(thermal_accumulator) > 0:\n        thermal_normalized = (thermal_accumulator / np.max(thermal_accumulator)) * 255\n    else:\n        thermal_normalized = thermal_accumulator\n        \n    thermal_normalized = np.uint8(thermal_normalized)\n\n    # Apply the industry-standard Jet colormap (Blue = Cold, Green = Warm, Red = Hot)\n    heatmap_color = cv2.applyColorMap(thermal_normalized, cv2.COLORMAP_JET)\n\n    # 4. Augmented Reality Blending\n    # We strip out the dark blue (zero-weight) background so it doesn't tint the whole store blue\n    alpha_blend = 0.6  # Heatmap opacity\n    traffic_mask = thermal_normalized > 10 # Only apply color where actual traffic occurred\n    \n    final_heatmap_overlay = base_frame.copy()\n    for channel in range(3): # Process B, G, R channels\n        final_heatmap_overlay[:, :, channel] = np.where(\n            traffic_mask, \n            (base_frame[:, :, channel] * (1.0 - alpha_blend) + heatmap_color[:, :, channel] * alpha_blend),\n            base_frame[:, :, channel]\n        )\n\n    print(\"✅ Thermal Matrix Compiled Successfully!\")\n\n    # 5. Render the Executive Heatmap Dashboard\n    fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n    fig.patch.set_facecolor('#0a0f12')\n\n    # Panel A: Raw Telemetry View\n    axes[0].imshow(cv2.cvtColor(heatmap_color, cv2.COLOR_BGR2RGB))\n    axes[0].set_title(\"RAW THERMAL SIGNATURE\", fontsize=12, fontweight='bold', color='#FFCC00')\n    axes[0].axis('off')\n\n    # Panel B: Augmented Reality Retail Overlay\n    axes[1].imshow(cv2.cvtColor(np.uint8(final_heatmap_overlay), cv2.COLOR_BGR2RGB))\n    axes[1].set_title(\"SPATIAL STOREFRONT OVERLAY (AR VIEW)\", fontsize=12, fontweight='bold', color='#00FFCC')\n    axes[1].axis('off')\n\n    plt.suptitle(\"PHASE 3: Cumulative Multi-Frame Dwell-Time Heatmap\", fontsize=16, fontweight='bold', color='#FF3333', y=1.05)\n    plt.tight_layout()\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-