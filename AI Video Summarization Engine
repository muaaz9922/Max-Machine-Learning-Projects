ileNotFoundError(f\"❌ Base path missing. Root folder structure has changed.\")\n\nprint(\"🔍 Scanning subdirectories for valid PNG sequences...\")\n# Fast non-recursive check to locate the image folders\nfor path, dirs, files in os.walk(search_root):\n    # As soon as we find a folder containing png frames, lock it and stop scanning\n    png_files = [f for f in files if f.lower().endswith('.png')]\n    if len(png_files) >= 10:\n        target_dir = path\n        break\n\nif not target_dir:\n    raise FileNotFoundError(\"❌ Could not locate any folders containing .png files inside the dataset paths.\")\n\n# Direct frame index extraction (Instantaneous)\nraw_frame_list = sorted([f for f in os.listdir(target_dir) if f.lower().endswith('.png')])\nprint(f\"\\n🎯 TARGET AUTO-LOCKED: {target_dir}\")\nprint(f\"🎞️ Indexed Buffer: {len(raw_frame_list)} raw incident frames located instantly.\")\n\n# 2. Motion Filter Hyperparameters\nMOTION_THRESHOLD = 15       # Minimum pixel value variance to flag change\nMIN_CHANGED_PIXELS = 1000   # Minimum total pixel area required to count as real movement\n\nfiltered_frames = []\nmotion_scores = []\nprevious_gray = None\n\n# Scan up to 150 frames of the file track for real-time responsiveness\nprocessing_limit = min(150, len(raw_frame_list))\nprint(f\"🎬 Running Motion-Activated Filtration over {processing_limit} frames...\")\n\nfor idx in range(processing_limit):\n    frame_path = os.path.join(target_dir, raw_frame_list[idx])\n    img = cv2.imread(frame_path)\n    if img is None:\n        continue\n        \n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    gray_blurred = cv2.GaussianBlur(gray, (21, 21), 0)\n    \n    if previous_gray is None:\n        previous_gray = gray_blurred\n        filtered_frames.append((frame_path, img, 0)) # Retain structural anchor frame\n        motion_scores.append(0)\n        continue\n    \n    # Mathematical delta matrix calculations (Pixel difference extraction)\n    frame_delta = cv2.absdiff(previous_gray, gray_blurred)\n    thresh = cv2.threshold(frame_delta, MOTION_THRESHOLD, 255, cv2.THRESH_BINARY)[1]\n    \n    motion_score = np.sum(thresh == 255)\n    motion_scores.append(motion_score)\n    \n    if motion_score >= MIN_CHANGED_PIXELS:\n        filtered_frames.append((frame_path, img, motion_score))\n        \n    previous_gray = gray_blurred\n\n# 3. Compute Structural Compression Metrics\ntotal_processed = len(motion_scores)\nretained_count = len(filtered_frames)\ndropped_count = total_processed - retained_count\ncompression_ratio = (dropped_count / total_processed) * 100\n\nprint(f\"\\n📊 --- SECURITY DE-DUPLICATION METRICS ---\")\nprint(f\"● Raw Stream Buffer Size : {total_processed} frames\")\nprint(f\"● Filtered Active Frames : {retained_count} frames\")\nprint(f\"● Dead-Air Frames Dropped: {dropped_count} frames\")\nprint(f\"● Stream Optimization Ratio: {compression_ratio:.2f}% Storage Volume reduction\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-21T04:10:15.966401Z","iopub.execute_input":"2026-05-21T04:10:15.967133Z","iopub.status.idle":"2026-05-21T04:10:23.510178Z","shell.execute_reply.started":"2026-05-21T04:10:15.967098Z","shell.execute_reply":"2026-05-21T04:10:23.509478Z"}},"outputs":[{"name":"stdout","text":"🔍 Scanning subdirectories for valid PNG sequences...\n\n🎯 TARGET AUTO-LOCKED: /kaggle/input/datasets/odins0n/ucf-crime-dataset/Test/RoadAccidents\n🎞️ Indexed Buffer: 2663 raw incident frames located instantly.\n🎬 Running Motion-Activated Filtration over 150 frames...\n\n📊 --- SECURITY DE-DUPLICATION METRICS ---\n● Raw Stream Buffer Size : 150 frames\n● Filtered Active Frames : 4 frames\n● Dead-Air Frames Dropped: 146 frames\n● Stream Optimization Ratio: 97.33% Storage Volume reduction\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"### **MOTION-ACTIVATED FILTERATION ENGINE ALONG WITH HIGH-SPEED SUBSAMPLING & STATIC FRAME FILTRATION**","metadata":{}},{"cell_type":"markdown","source"